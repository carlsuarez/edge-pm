// STM32F411RE for edge-pm firmware emulation.
//
// Built on Renode's bundled STM32F4 description (platforms/cpus/stm32f4.repl), which already
// models USART2, SPI2 (with DMA1 receive), DMA1, the GPIO ports, NVIC and timers we use.
// We only specialise it for the F411: a Cortex-M4F core (hard-float, matching our
// thumbv7em-none-eabihf build) and the F411's 128 KB SRAM (the base maps 256 KB).
//
// `using` resolves this against Renode's own install directory, so it works wherever
// Renode is installed (don't hardcode a path to a specific Renode checkout).
using "platforms/cpus/stm32f4.repl"

cpu:
    cpuType: "cortex-m4f"

sram:
    size: 0x00020000   // 128 KB on the F411RE
